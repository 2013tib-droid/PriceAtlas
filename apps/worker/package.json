    "heic-decode": "^2.1.0",
    "pg": "^8.16.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@priceatlas/testkit": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
