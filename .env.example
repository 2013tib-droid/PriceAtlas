# Salin ke .env lalu isi. Jangan pernah commit .env (D-61, docs/05-backend-design.md §7.7).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only: apps/web route handler, apps/worker
DATABASE_URL=                     # worker: koneksi sesi (bukan transaction pooler) untuk LISTEN
WORKER_DB_ROLE=service_role       # F-22: mode A dan B. Worker berjalan sebagai service_role, bukan pemilik objek
STORAGE_BACKEND=supabase          # supabase | local
LOCAL_STORAGE_DIR=./.data/storage # jika STORAGE_BACKEND=local
EXTRACTOR=stub                    # Tahap 6: vision | ocr+parse
STUB_FIXTURES_DIR=                # opsional, default apps/worker/test/fixtures
GOOGLE_OAUTH_CLIENT_ID=           # mode B: Google mati kecuali SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=true (F-21)
GOOGLE_OAUTH_SECRET=
NEXT_PUBLIC_SW_DEV=               # opsional: "1" menyalakan service worker di next dev (docs/07 §11.5)
# Tanya (docs/08 §10, docs/06 §2.8). Server-only: apps/web/.env.local, TIDAK PERNAH NEXT_PUBLIC_.
ANTHROPIC_API_KEY=                # kunci "web" (terpisah dari kunci worker); kosong → Tanya "Segera hadir"
ASK_ENGINE=claude                 # claude | stub (e2e/CI, tanpa Claude) | off
ASK_MODEL=                        # opsional, default claude-opus-5-5; model lain hanya untuk set pertanyaan emas (Q-115)
