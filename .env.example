# Salin ke .env lalu isi. Jangan pernah commit .env (D-61, docs/05-backend-design.md §7.7).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only: apps/web route handler, apps/worker
DATABASE_URL=                     # worker: koneksi sesi (bukan transaction pooler) untuk LISTEN
WORKER_DB_ROLE=service_role       # F-22: mode A dan B. Worker berjalan sebagai service_role, bukan pemilik objek
STORAGE_BACKEND=supabase          # supabase | local
LOCAL_STORAGE_DIR=./.data/storage # jika STORAGE_BACKEND=local
EXTRACTOR=off                     # off = mode pribadi D-100 (hanya struk tempelan, tanpa AI) | stub (CI/e2e, fixture) | vision | ocr+parse (docs/08 §5.1; pilihan final D-16)
AI_MATCHER=off                    # off = tanpa tier 4 (D-100) | stub (CI/e2e) | claude: matcher tier 4 dengan EXTRACT_MODEL (docs/08 §7)
WORKER_ANTHROPIC_API_KEY=         # kunci "worker", wajib jika EXTRACTOR = vision | ocr+parse atau AI_MATCHER=claude; terpisah dari ANTHROPIC_API_KEY web (F-167)
EXTRACT_MODEL=                    # opsional, default claude-opus-5-5; harus ada di tabel harga packages/ai-tools/src/pricing.ts
EXTRACT_EFFORT_RECEIPT=           # opsional: low | medium | high, default medium
EXTRACT_EFFORT_OBSERVATION=       # opsional: low | medium | high, default low (label + screenshot)
OCR_ENGINE=                       # hanya EXTRACTOR=ocr+parse: google-vision (default), pakai GOOGLE_VISION_API_KEY di bawah
STUB_FIXTURES_DIR=                # opsional, default apps/worker/test/fixtures
STUB_FALLBACK_FIXTURE=            # KHUSUS worker e2e (Q-82): nama fixture untuk gambar tak dikenal (mis. label-milo); jangan diisi di dev/produksi
CAPTURE_LEASE_SECONDS=            # opsional, default 300; worker menolak start jika > app.config capture_processing_timeout_seconds (docs/08 §5.4)
AI_DAILY_BUDGET_USD=              # opsional: override app.config ai_daily_budget_usd (2,00); habis → worker tidak claim (docs/08 §12.3)
GOOGLE_OAUTH_CLIENT_ID=           # mode B: Google mati kecuali SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=true (F-21)
GOOGLE_OAUTH_SECRET=
NEXT_PUBLIC_SW_DEV=               # opsional: "1" menyalakan service worker di next dev (docs/07 §11.5)
NEXT_PUBLIC_PHOTO_CAPTURE=off     # D-100 (docs/08 §23): off/kosong = foto mati, struk lewat /tempel (Gemini); on = foto aktif (+ EXTRACTOR ≠ off). Dibaca saat build
# Tanya (docs/08 §10, docs/06 §4.11). Server-only: apps/web/.env.local, TIDAK PERNAH NEXT_PUBLIC_.
ANTHROPIC_API_KEY=                # kunci "web" (terpisah dari kunci worker); kosong → Tanya "Segera hadir"
ASK_ENGINE=off                    # off = mode pribadi D-100 | claude | stub (e2e/CI, tanpa Claude)
ASK_MODEL=                        # opsional, default claude-opus-5-5; model lain hanya untuk set pertanyaan emas (Q-115)
# Uji OCR D-16 (harness ocr-eval, docs/06 §2.8): dijalankan pemilik proyek di mesinnya, kunci di shell.
OCR_EVAL_DIR=                     # opsional, default .data/ocr-eval (wajib di-gitignore atau di luar repo, F-117)
GOOGLE_VISION_API_KEY=            # arm ocr-gcv+opus-low (docs/08 §4.5) dan worker EXTRACTOR=ocr+parse; dibatasi ke Vision API
